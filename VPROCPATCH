+		case 0x32: return bcd(cmos[0xb], tm->year / 100 + 19);
+		default:
+			if(addr < nelem(cmos))
+				return cmos[addr];
+			vmerror("rtc: read from unknown address %#x", addr);
+			return 0;
+		}
+	}
