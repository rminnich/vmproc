+ulong
+vioqread(VIOBuf *b, void *v, ulong n)
+{
+	VIOBuf *c;
+	u32int p;
+	int rc;
+	ulong m;
+	
+	p = b->rptr;
+	c = b;
+	rc = 0;
+	for(;;){
+		if(rc >= n) return rc;
+		for(;;){
+			if(c == nil) return rc;
+			if((c->flags & BUFWR) == 0){
+				if(p < c->len) break;
+				p -= c->len;
+			}
+			c = c->next;
+		}
+		m = c->len - p;
+		if(m > n - rc) m = n - rc;
+		memmove(v, (u8int*)c->p + p, m);
+		p += m, rc += m;
+		v = (u8int*)v + m;
+		b->rptr += m;
+	}
