+static void
+addmode(int no, int x, int y, u32int chan)
+{
+	VgaMode *vm;
+	
+	vm = emalloc(sizeof(VgaMode));
+	vm->no = no;
+	vm->w = x;
+	vm->h = y;
+	vm->chan = chan;
+	vm->hbytes = chantodepth(chan) * vm->w + 7 >> 3;
+	vm->sz = vm->hbytes * y;
+	*modeslast = vm;
+	modeslast = &vm->next;
+}
