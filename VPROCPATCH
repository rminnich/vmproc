+void
+drawproc(void *)
+{
+	ulong ul;
+	int event;
+	VgaMode *m;
+
+	threadsetname("draw");
+	sfb = emalloc(fbsz);
+	event = 4;
+	for(;; sleep(20)){
+		qlock(&vga);
+		m = nextmode;
+		if(m != curmode){
+			event |= 1;
+			curmode = m;
+			curhbytes = m->hbytes;
+		}
+		if(nexthbytes != curhbytes){
+			event |= 1;
+			curhbytes = nexthbytes;
+		}
