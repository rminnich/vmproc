+char *
+rcflush(int togo)
+{
+	int i, j;
+	static char buf[4096];
+	char *p, *e;
+	uvlong v;
+	
+	p = buf;
+	e = buf + sizeof(buf);
+	*p = 0;
+	for(i = 0; i < (RCENT+63)/64; i++){
+		if(v = rcdirty[i], v != 0){
+			for(j = 0; j < 64; j++)
+				if((v>>j & 1) != 0)
+					p = seprint(p, e, "%s%c%#ullx%c", rcname[i*64+j], togo?'=':' ', rcval[i*64+j], togo?';':'\n');
+			rcdirty[i] = 0;
+		}
+		rcvalid[i] = 0;
+	}
+	if(!togo && p != buf && write(regsfd, buf, p - buf) < p - buf)
+		sysfatal("rcflush: write: %r");
+	return p != buf ? buf : nil;
+}
