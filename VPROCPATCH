From: glenda <glenda@maxroach>
Date: Thu, 21 Nov 2024 05:43:40 +0000
Subject: [PATCH 1/13] Prepare for vmproc page table pages.

The variable vmproc is 0 or non-zero. If zero, all sizes in
mmu.c remain unchanged. If non-zero, BY2PG and PTSZ in mmu.c
are doubled. This may have weird implications for device I/O,
we may be incorrectly doubly BY2PG when we should not.
---
diff 03cb81c7a50bf1c85fe54e05da88f8687d1e8346 97e5fee23321a7a172634b67303148dd0485acf3
--- a/sys/src/9/pc64/mmu.c
+++ b/sys/src/9/pc64/mmu.c
@@ -13,6 +13,12 @@
 #define	EXEC32SEGM(p) 	{ 0xFFFF, SEGG|SEGD|(0xF<<16)|SEGP|SEGPL(p)|SEGEXEC|SEGR }
 #define	DATA32SEGM(p) 	{ 0xFFFF, SEGB|SEGG|(0xF<<16)|SEGP|SEGPL(p)|SEGDATA|SEGW }
 
+/*
+ * vmproc
+ */
+#define VPTSZ ((vmproc?2:1)*PTSZ)
+#define VBY2PG ((vmproc?2:1)*BY2PG)
+
 Segdesc gdt[NGDT] =
 {
 [NULLSEG]	{ 0, 0},		/* null descriptor */
@@ -180,7 +186,7 @@
 			p = malloc(n * sizeof(MMU));
 			if(p == nil)
 				panic("mmualloc: out of memory for MMU");
-			p->page = mallocalign(n * PTSZ, BY2PG, 0, 0);
+			p->page = mallocalign(n * VPTSZ, VBY2PG, 0, 0);
 			if(p->page == nil)
 				panic("mmualloc: out of memory for MMU pages");
 			for(i=1; i<n; i++){
@@ -240,7 +246,7 @@
 	} else {
 		page = rampage();
 	}
-	memset(page, 0, PTSZ);
+	memset(page, 0, VPTSZ);
 	table[index] = PADDR(page) | flags;
 	return page;
 }
@@ -323,7 +329,7 @@
 			continue;
 		if(va >= KTZERO && va < (uintptr)etext)
 			*pte &= ~PTEWRITE;
-		else if(va != (APBOOTSTRAP & -BY2PG))
+		else if(va != (APBOOTSTRAP & -VBY2PG))
 			*pte |= PTENOEXEC;
 		invlpg(va);
 	}
@@ -589,7 +595,7 @@
 	uintptr va;
 	int o;
 
-	if(pa < BY2PG || size <= 0 || -pa < size || pa+size > VMAPSIZE){
+	if(pa < VBY2PG || size <= 0 || -pa < size || pa+size > VMAPSIZE){
 		print("vmap pa=%llux size=%lld pc=%#p\n", pa, size, getcallerpc(&pa));
 		return nil;
 	}
@@ -598,7 +604,7 @@
 	/*
 	 * might be asking for less than a page.
 	 */
-	o = pa & (BY2PG-1);
+	o = pa & (VBY2PG-1);
 	pa -= o;
 	va -= o;
 	size += o;
@@ -666,12 +672,12 @@
 	nt = np / 50;	/* 2% for mmupool */
 	np -= nt;
 
-	nt = (uvlong)nt*BY2PG / (sizeof(MMU)+PTSZ);
-	tsize = (uvlong)nt * (sizeof(MMU)+PTSZ);
+	nt = (uvlong)nt*VBY2PG / (sizeof(MMU)+VPTSZ);
+	tsize = (uvlong)nt * (sizeof(MMU)+VPTSZ);
 
-	psize = (uvlong)np * BY2PG;
-	psize += sizeof(Page) + BY2PG;
-	psize = (psize / (sizeof(Page)+BY2PG)) * sizeof(Page);
+	psize = (uvlong)np * VBY2PG;
+	psize += sizeof(Page) + VBY2PG;
+	psize = (psize / (sizeof(Page)+VBY2PG)) * sizeof(Page);
 
 	psize += tsize;
 	psize = ROUND(psize, PGLSZ(1));
@@ -679,13 +685,13 @@
 	for(i=0; i<nelem(conf.mem); i++){
 		cm = &conf.mem[i];
 		base = cm->base;
-		top = base + (uvlong)cm->npage * BY2PG;
-		base += (uvlong)nkpages(cm) * BY2PG;
+		top = base + (uvlong)cm->npage * VBY2PG;
+		base += (uvlong)nkpages(cm) * VBY2PG;
 		top &= -PGLSZ(1);
 		if(top <= VMAPSIZE && (vlong)(top - base) >= psize){
 			/* steal memory from the end of the bank */
 			top -= psize;
-			cm->npage = (top - cm->base) / BY2PG;
+			cm->npage = (top - cm->base) / VBY2PG;
 
 			va = top + VMAP;
 			pmap(top | PTEGLOBAL|PTEWRITE|PTENOEXEC|PTEVALID, va, psize);
@@ -693,11 +699,11 @@
 			palloc.pages = (void*)(va + tsize);
 
 			mmupool.nfree = mmupool.nalloc = nt;
-			mmupool.free = (void*)(va + (uvlong)nt*PTSZ);
