+static void *
+checkdesc(VIOQueue *q, int i)
+{
+	if(i >= q->size){
+		vmerror("virtio device %#x: invalid next pointer %d in queue (size %d), ignoring descriptor", q->d->pci->bdf, i, q->size);
+		return nil;
