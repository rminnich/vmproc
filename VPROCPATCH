+void
+rtcadvance(void)
+{
+	vlong t;
+	
+	if(rtcnext != -1){
+		t = nanosec();
+		if(t >= rtcnext){
+			cmos[0xc] |= 0x40;
+			rtcnext = -1;
+		}else
+			settimer(rtcnext);
+	}
+	irqline(8, (cmos[0xc] & cmos[0xb] & 0x70) != 0); 
+}
+
+static void
+rtcset(void)
+{
+	vlong t, b;
+	int d;
+
+	rtcadvance();
+	if((cmos[0xa] >> 4) > 2 || (cmos[0xa] & 15) == 0 || (cmos[0xc] & 0x40) != 0){
+		rtcnext = -1;
+		return;
+	}
+	switch(cmos[0xa]){
+	case 0x21: d = 12; break;
+	case 0x22: d = 13; break;
+	default: d = 4 + (cmos[0xa] & 0xf);
+	}
+	b = (1000000000ULL << d) / 1048576;
+	t = nanosec();
+	rtcnext = t + b - t % b;
+	settimer(rtcnext);
+}
