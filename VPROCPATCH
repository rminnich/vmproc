+static int
+putmods(uchar *p0)
+{
+	int i, fd, rc;
+	u32int *p;
+	uchar *q;
+	char dummy;
+
+	if(bootmodn == 0) return 0;
+	p = (u32int*)p0;
+	q = (uchar*)(p + 4 * bootmodn);
+	for(i = 0; i < bootmodn; i++){
+		q = gptr(-(-gpa(q) & -BY2PG), 1);
+		if(q == nil) sysfatal("out of guest memory");
+		fd = open(bootmod[i], OREAD);
+		if(fd == -1) sysfatal("module open: %r");
+		p[0] = gpa(q);
+		rc = readn(fd, q, gavail(q));
