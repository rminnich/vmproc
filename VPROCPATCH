+		while(i < sz && l-- > 0)
+			pa[i++] = pav++;
+	}
+	if(szmax >= sz){
+		r = regptr(pa[0]);
+		if(r == nil || pa[0]+sz > r->end) goto slow;
+		ptr = (uchar*)r->v + (pa[0] - r->start);
+		if(tlb != nil){
+			l = gavail(ptr);
+			if(l < szmax) szmax = l;
+			tlb->asz = asz;
+			tlb->seg = seg;
+			tlb->acc = (u8int)acc;
+			tlb->start = addr0;
+			tlb->end = addr0 + szmax;
+			tlb->reg = r;
+			tlb->base = ptr - addr0;
+			tlb->pabase = pa[0] - addr0;
+		}
+	fast:
+		if(r->mmio != nil)
+			r->mmio(pa[0], val, sz, (u8int)acc == ACCW);
