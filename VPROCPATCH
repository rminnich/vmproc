+static int
+putcmdline(uchar *p0)
+{
+	int i;
+	char *p, *e;
+	
+	if(cmdlinen == 0) return 0;
+	p = (char*)p0;
+	e = gend(p0);
+	if(p >= e) return 0;
+	for(i = 0; i < cmdlinen; i++){
+		p = strecpy(p, e, cmdlinev[i]);
+		if(i != cmdlinen - 1) *p++ = ' ';
+	}
