From: glenda <glenda@maxroach>
Date: Fri, 22 Nov 2024 20:15:02 +0000
Subject: [PATCH 7/13] Add RFVMPROC/RFCVMPROC to libc.h and portdat.h

add vmproc to sysproc.c, so that it is optional
to use for all architectures.
add handling for rfork(RF[C]VMPROC)
---
diff 460d8e8146ff60f9b2e7c8dbbc84166c0249c3af f22bfce17f5a64ee87b5e93feba7826503af0f35
--- a/sys/include/libc.h
+++ b/sys/include/libc.h
@@ -646,7 +646,9 @@
 	RFCENVG		= (1<<11),
 	RFCFDG		= (1<<12),
 	RFREND		= (1<<13),
-	RFNOMNT		= (1<<14)
+	RFNOMNT		= (1<<14),
+	RFVMPROC	= (1 << 15),
+	RFCVMPROC	= (1 << 16),
 };
 
 typedef
--- a/sys/src/9/port/portdat.h
+++ b/sys/src/9/port/portdat.h
@@ -593,6 +593,8 @@
 	RFCFDG		= (1<<12),
 	RFREND		= (1<<13),
 	RFNOMNT		= (1<<14),
+	RFVMPROC	= (1 << 15),
+	RFCVMPROC	= (1 << 16),
 };
 
 /*
@@ -778,6 +780,7 @@
 	void	*ureg;		/* User registers for notes */
 	void	*dbgreg;	/* User registers for devproc */
 
+	int vmproc; 	/* If 1, this is a vmproc. All other values, it is a normal proc. */
 	PFPU;			/* machine specific fpu state */
 	PMMU;			/* machine specific mmu state */
 
--- a/sys/src/9/port/sysproc.c
+++ b/sys/src/9/port/sysproc.c
@@ -9,6 +9,20 @@
 
 #include	<a.out.h>
 
+/*
+ * A vmproc is like a user-mode process, save that it is running in a VM.
+ * When the kernel exits to the process, it uses a VMENTER or equivalent.
+ * To convert a process to a vmproc, call rfork(RFVMPROC); to convert back,
+ * call rfork(RFCVMPROC);
+ * Not all ports support vmprocs. Those that do can use this variable
+ * to determine if vmproc is enabled.
+ * This variable is defined here so programs can use rfork, but the rfork
+ * code itself need not depend on an architecture port defining it. That way,
+ * we can have some architectures implement it, and others not. Hopefully,
+ * over time, all architectures will support it.
+ */
+int vmproc = 0;
+
 uintptr
 sysr1(va_list)
 {
@@ -88,6 +102,9 @@
 			qlock(&up->debug);
 			setnoteid(up, 0);	/* can't error() with 0 argument */
 			qunlock(&up->debug);
+		}
+		if(flag & (RFVMPROC|RFCVMPROC)) {
+			up->vmproc = (flag&RFVMPROC)? 1 : 0;
 		}
 		return 0;
 	}
