+void
+mousethread(void *)
+{
+	Mouse m;
+	static Mouse mm, om;
+	int gotm;
+	Point mid;
+	Rectangle grabout;
+	int clicked;
+	static Cursor blank;
+	
+	gotm = 0;
+	clicked = 0;
+	for(;;){
+		Alt a[] = {
+			{mc->c, &m, CHANRCV},
+			{mousech, &mm, gotm ? CHANSND : CHANNOP},
+			{nil, nil, CHANEND},
+		};
+		
+		switch(alt(a)){
+		case 0:
+			mid = divpt(addpt(picr.max, picr.min), 2);
+			grabout = insetrect(Rpt(mid, mid), -50);
+			if(!ptinrect(m.xy, picr)){
+				clicked = 0;
+				break;
+			}
+			if(!mousegrab){
+				if(clicked && (m.buttons & 1) == 0 && mouseactive){
+					mousegrab = 1;
+					setcursor(mc, &blank);
+				}
+				clicked = m.buttons & 1;
+				break;
+			}
+			if(kbwatchdog != 0 && nanosec() - kbwatchdog > 1000ULL*1000*1000)
+				mousegrab = 0;
+			gotm = 1;
+			if(!ptinrect(m.xy, grabout)){
+				moveto(mc, mid);
+				m.xy = mid;
+				om.xy = mid;
+			}
+			mm.xy = addpt(mm.xy, subpt(m.xy, om.xy));
+			om = m;
+			mm.buttons = m.buttons;
+			break;
+		case 1:
+			sendnotif(i8042kick, nil);
+			mm.xy = Pt(0,0);
+			gotm = 0;
+			break;
+		}
+	}
+}
