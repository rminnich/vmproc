+static int
+putmmap(uchar *p0)
+{
+	uchar *p;
+	Region *r;
+	int t;
+	
+	p = p0;
+	for(r = mmap; r != nil; r = r->next){
+		t = biostype(r);
+		if(t == 0) continue;
+		if(gavail(p) < 24) sysfatal("out of guest memory");
+		p = pack(p, "ivvi", 20, (uvlong) r->start, (uvlong)(r->end - r->start), t);
+	}
+	return (uchar *) p - p0;
+}
