+static void
+fdccmd(u8int val)
+{
+	vmdebug("fdc: cmd %#x", val);
+	switch(val){
+	case 0x03:
+		fdc.dump = 2;
+		break;
+	case 0x07:
+		fdc.dump = 1;
+		fdc.irq = 1;
+		break;
+	case 0x08:
+		irqline(6, 0);
+		fdcputc(0x80);
+		fdcputc(0);
+		break;
+	default:
+		vmerror("unknown fdc command %.2x", val);
+	}
