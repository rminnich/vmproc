+					PUT8(r->v, pa[i] - r->start, tval);
+			}else{
+				if(r->mmio != nil)
+					r->mmio(pa[i], &tval, 1, 0);
+				else
+					tval = GET8(r->v, pa[i] - r->start);
+				PUT8(val, i, tval);
+			}	
+		}
+	}
+	return 0;
+}
