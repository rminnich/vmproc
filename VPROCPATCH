+typedef struct Key Key;
+struct Key {
+	Rune r;
+	int code;
+	Key *next;
+};
+Key *kbdmap[128];
+
+static void
+defkey(Rune r, int code)
+{
+	Key *k, **kp;
+
+	for(kp = &kbdmap[r % nelem(kbdmap)]; *kp != nil; kp = &(*kp)->next)
+		if((*kp)->r == r)
+			return;
+	k = emalloc(sizeof(Key));
+	k->r = r;
+	k->code = code;
+	*kp = k;
+}
