 			for(i=0; i<nt; i++){
 				mmupool.free[i].page = (uintptr*)va;
 				mmupool.free[i].next = &mmupool.free[i+1];
-				va += PTSZ;
+				va += VPTSZ;
 			}
 			mmupool.free[i-1].next = nil;
 
