From: glenda <glenda@maxroach>
Date: Thu, 21 Nov 2024 05:46:19 +0000
Subject: [PATCH 1/4] Change a few VBY2PG back to BY2PG when it looks like we

are talking about the size of objects a page refers to.
---
diff 97e5fee23321a7a172634b67303148dd0485acf3 d1117d8c1104a9315d30cbea956f2ff4728ae538
--- a/sys/src/9/pc64/mmu.c
+++ b/sys/src/9/pc64/mmu.c
@@ -329,7 +329,7 @@
 			continue;
 		if(va >= KTZERO && va < (uintptr)etext)
 			*pte &= ~PTEWRITE;
-		else if(va != (APBOOTSTRAP & -VBY2PG))
+		else if(va != (APBOOTSTRAP & -BY2PG))
 			*pte |= PTENOEXEC;
 		invlpg(va);
 	}
@@ -595,7 +595,7 @@
 	uintptr va;
 	int o;
 
-	if(pa < VBY2PG || size <= 0 || -pa < size || pa+size > VMAPSIZE){
+	if(pa < BY2PG || size <= 0 || -pa < size || pa+size > VMAPSIZE){
 		print("vmap pa=%llux size=%lld pc=%#p\n", pa, size, getcallerpc(&pa));
 		return nil;
 	}
@@ -604,7 +604,7 @@
 	/*
 	 * might be asking for less than a page.
 	 */
-	o = pa & (VBY2PG-1);
+	o = pa & (BY2PG-1);
 	pa -= o;
 	va -= o;
 	size += o;

