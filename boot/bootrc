#!/bin/rc

# mount points
mntgen -s slashn /n && chmod 666 /srv/slashn
mntgen -s slashmnt /mnt && chmod 666 /srv/slashmnt
mntgen -s mntexport /mnt/exportfs && chmod 666 /srv/mntexport

# bind in devices
for(i in t b m) # need t or no console b & m or acme fails first time ... weird
	bind -qa '#'^$i /dev

v=/mnt/vmproc
bind '#Z'/ $v

# reparse variables
for(i in `{ls -Qp /env}){
	switch($i){
	case '*'* 'fn#'* e820 apm0 essid wpapsk apid ifs path pid prompt status ?
		# ignore these
	case *
		$i=`{echo $$i}
	}
}

fn sigint {
	status=interrupted
}

fn fatal {
	echo $* >[1=2]
	exit $"*
}

fn must {
	$* || fatal $"*^': '^$status
}


fn main{
	# authentication agent
	if(! test -f /srv/factotum){
		x=(/boot/factotum -n -sfactotum)
		if(~ $service cpu)
			x=($x -S)
		if not
			x=($x -u)
		if(! ~ $#debugfactotum 0)
			x=($x -p)
		must $x
	}

	echo TRY THIS RC ps works
	bind /$v/$cputype /$cputype
	/$cputype/bin/bind /$cputype/bin /bin
	for(i in acme adm dist lib net rc sys usr dev)
		bind /$v/$i /$i
	bind -a /rc/bin /bin
	ramfs
	/bin/rc
	echo DONE THAT RC
	exit 1

}

# keyboard and serial console
if(test -x /bin/aux/kbdfs){
	a=$console(1)
	if(! ~ $#a 0)
		a=/dev/eia^$a
	aux/kbdfs -q -s cons $a

	if(! ~$#kbmap 0){
		if(test -f /sys/lib/kbmap/$kbmap){
			echo 'setting kbmap to' $kbmap
			cat /sys/lib/kbmap/$kbmap >/dev/kbmap
		}
	}
}

for(i in /rc/lib/*.rc){
	. $i
}

while(){
	@{main}

	# subshell doesnt wait on interrupts
	while(~ $status interrupted){wait}

	# cleanup so it can be restarted
	nobootprompt=()
} </dev/cons
